# Required for local authentication. Use a long, unique value outside development.
ADMIN_PASSWORD=change-this-before-running
AUTH_SECRET=replace-with-a-long-random-secret

# Production PostgreSQL only. For the detached local development database, leave
# this commented out: `npm run dev` supplies its local value automatically.
# DATABASE_URL="postgresql://phonein:phonein@localhost:5432/ai_phone_in?schema=public"

# Caller Workshop, AI images and OpenAI Realtime voice. The permanent key stays
# on the server and is never sent to the browser.
OPENAI_API_KEY=
# Preserves the requested initial target; change only if your API project exposes a different Realtime model.
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
# Used only when a producer explicitly requests ideas in Caller Workshop. gpt-5.4-mini balances cost and speed; override if required.
OPENAI_CALLER_GENERATION_MODEL=gpt-5.4-mini
# Used by the optional caller portrait/topic image generator.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional Gemini Live comparison route. The server exchanges this permanent key
# for a one-use browser token; it is never returned to the client.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional global voice override. When blank, caller voice choices map to a small
# set of Gemini prebuilt voices.
GEMINI_LIVE_VOICE=

# Optional full-duplex ElevenLabs conversational caller route. Create an ElevenLabs
# Conversational AI Agent, then keep both values server-only in .env.local.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional stock-image providers for the caller image-feed search. Add either one,
# never both unless you want the Studio's automatic provider fallback.
PEXELS_API_KEY=
PIXABAY_API_KEY=
