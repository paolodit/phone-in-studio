    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@prisma/cli-dev": "^0.16.22",
    "@types/node": "22.15.3",
    "@types/pg": "^8.20.0",
